<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aspire.AppHost.Sdk injects the DCP binary references and embeds the
       dcpclipath / aspiredashboardpath AssemblyMetadata attributes that
       DistributedApplication.CreateBuilder requires to locate the DCP process.
       This is the pre-approved R-1 fallback documented in the engine's
       CLAUDE.md §"Aspire (§4, §19)": a plain Aspire.Hosting library reference
       alone does NOT carry the DCP binaries, and StartAsync then throws
       OptionsValidationException ("CliPath ... is required"). Mirrors
       .vouchfx-src/src/Cli/Vouchfx.Cli/Vouchfx.Cli.csproj line-for-line on this
       point: THIS project is the executable that hosts the engine, so it (not
       the engine library) must carry the SDK and pass its OWN assembly name to
       ScenarioRunner.RunSuiteAsync as appHostAssemblyName (see Program.cs). -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LedgerRunner</AssemblyName>
    <RootNamespace>Ledger.Runner</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Mark this project as an Aspire host so the AppHost build targets embed
         the DCP metadata onto THIS assembly (the one whose name Program.cs
         passes to ScenarioRunner.RunSuiteAsync as appHostAssemblyName). -->
    <IsAspireHost>true</IsAspireHost>
    <!-- This runner lives OUTSIDE .vouchfx-src, so it does NOT inherit that
         tree's Directory.Build.props / Directory.Packages.props (no central
         package management here — every PackageReference below pins an
         explicit Version). Not packable; this is a sample runner, not a
         published artifact. -->
    <IsPackable>false</IsPackable>
    <!-- npm-parity supply-chain manifest: the exact resolved graph (incl.
         transitive versions + content hashes) is recorded in the adjacent
         packages.lock.json, mirroring what package-lock.json records for
         the Node samples. NOTE: without RestoreLockedMode the lock file
         is a recorded manifest with integrity hashes, not an enforced gate —
         restore updates it silently on drift. Locked-mode enforcement is
         deliberately NOT enabled: the DCP packages are referenced for all four
         platforms below, so the Aspire entries no longer depend on the host's RID,
         but the lock was generated on Linux and has not been checked against a
         locked-mode restore on Windows or macOS; verify that before enabling it. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Headless Aspire host — no dashboard package">
    <!-- The SDK's default references add Aspire.Hosting.AppHost plus, for the build
         host's RID, Aspire.Hosting.Orchestration (DCP, which the engine needs) and
         Aspire.Dashboard.Sdk (the dashboard, which the engine never starts: its headless
         topology always disables it). Every Aspire.Dashboard.Sdk release below 13.6.5
         carries GHSA-4g86-54fm-h9h8 (critical, NU1904), and the engine stays on Aspire
         13.4.x for v1.x. Skipping the defaults and referencing DCP explicitly keeps the
         dashboard package out of the restore graph, exactly as the engine's
         Vouchfx.Dcp.targets does for the CLI (.vouchfx-src/src/Cli/Vouchfx.Cli/): the
         dependency is removed, not an audit suppression. The AppHost reference below is
         then mandatory (the SDK reports ASPIRE002 without it). -->
    <SkipAddAspireDefaultReferences>true</SkipAddAspireDefaultReferences>
    <!-- Aspire validates DashboardPath as non-empty even with the dashboard disabled;
         keep the metadata contract without restoring dashboard binaries. -->
    <AspireDashboardPath>disabled-by-vouchfx-headless-host</AspireDashboardPath>
    <!-- Distro-built SDKs report a non-portable RID (ubuntu.24.04-x64); use its portable form. -->
    <_LedgerDcpHostRid>$(NETCoreSdkPortableRuntimeIdentifier)</_LedgerDcpHostRid>
    <_LedgerDcpHostRid Condition="'$(_LedgerDcpHostRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_LedgerDcpHostRid>
    <!-- Set during evaluation: Aspire's discovery target is skipped when DcpDir is empty.
         A build host whose portable RID is not one of these four gets no dcpclipath. -->
    <DcpDir Condition="'$(_LedgerDcpHostRid)' == 'win-x64'">$(PkgAspire_Hosting_Orchestration_win-x64)/tools/</DcpDir>
    <DcpDir Condition="'$(_LedgerDcpHostRid)' == 'linux-x64'">$(PkgAspire_Hosting_Orchestration_linux-x64)/tools/</DcpDir>
    <DcpDir Condition="'$(_LedgerDcpHostRid)' == 'osx-x64'">$(PkgAspire_Hosting_Orchestration_osx-x64)/tools/</DcpDir>
    <DcpDir Condition="'$(_LedgerDcpHostRid)' == 'osx-arm64'">$(PkgAspire_Hosting_Orchestration_osx-arm64)/tools/</DcpDir>
  </PropertyGroup>

  <ItemGroup Label="Aspire host wiring — pinned explicitly (no CPM in this tree)">
    <!-- AppHost must be a direct reference so its build targets run and embed
         the DCP metadata (Aspire.AppHost.Sdk auto-adds it implicitly; the
         explicit reference here pins the version since CPM does not reach
         this project). -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <!-- DCP for the four platforms the engine supports; build assets are excluded so a
         foreign RID cannot overwrite DcpDir, which is set above from the build host's
         own RID. Keep this version equal to the engine's VouchfxDcpVersion at the commit
         in ENGINE_PIN (Directory.Packages.props). -->
    <PackageReference Include="Aspire.Hosting.Orchestration.win-x64" Version="13.4.6" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Aspire.Hosting.Orchestration.linux-x64" Version="13.4.6" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Aspire.Hosting.Orchestration.osx-x64" Version="13.4.6" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Aspire.Hosting.Orchestration.osx-arm64" Version="13.4.6" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup Label="The community provider under test">
    <PackageReference Include="Vouchfx.Community.JsonRpc" Version="[1.0.0]" />
  </ItemGroup>

  <ItemGroup Label="Engine + SDK + Core providers — source ProjectReferences into .vouchfx-src, pinned via ../../../ENGINE_PIN">
    <!-- IsAspireProjectResource=false: these are libraries linked into the
         runner, not orchestrated services that Aspire should treat as project
         resources (mirrors Vouchfx.Cli.csproj). -->
    <ProjectReference Include="..\..\..\.vouchfx-src\src\Engine\Vouchfx.Engine.Runtime\Vouchfx.Engine.Runtime.csproj"
                       IsAspireProjectResource="false" />
    <!-- DIRECT reference to the Sdk project (not just transitive via
         Engine.Runtime): this locks NuGet's project-over-package precedence,
         so the community package's "Vouchfx.Sdk >= 1.0.0" dependency
         unifies onto THIS source project instead of pulling down the
         Vouchfx.Sdk NuGet package. Verified by `dotnet list package
         (with the include-transitive flag)` showing no Vouchfx.Sdk package node. -->
    <ProjectReference Include="..\..\..\.vouchfx-src\src\Sdk\Vouchfx.Sdk\Vouchfx.Sdk.csproj"
                       IsAspireProjectResource="false" />
    <!-- The four Core providers the ledger-jsonrpc suite exercises alongside
         rpc.json-rpc. -->
    <ProjectReference Include="..\..\..\.vouchfx-src\src\Providers\Core\Vouchfx.Steps.DbAssert.Postgres\Vouchfx.Steps.DbAssert.Postgres.csproj"
                       IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\..\.vouchfx-src\src\Providers\Core\Vouchfx.Steps.MqPublish.Kafka\Vouchfx.Steps.MqPublish.Kafka.csproj"
                       IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\..\.vouchfx-src\src\Providers\Core\Vouchfx.Steps.MqExpect.Kafka\Vouchfx.Steps.MqExpect.Kafka.csproj"
                       IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\..\.vouchfx-src\src\Providers\Core\Vouchfx.Steps.Script.Csharp\Vouchfx.Steps.Script.Csharp.csproj"
                       IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup Label="Provider client libs — direct refs so the DLLs deploy to output (mirrors Vouchfx.Cli.csproj)">
    <!-- The providers resolve these via Assembly.Location at runtime (and the
         Roslyn compile needs them on the reference path); a transitive
         project-reference path alone does not guarantee deployment to the
         output directory. Referenced directly here so the DLLs ship with the
         runner. Versions copied verbatim from .vouchfx-src/Directory.Packages.props
         (CPM does not reach this project, so they are pinned explicitly). -->
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="Confluent.SchemaRegistry" Version="2.16.0" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.16.0" />
    <PackageReference Include="Apache.Avro" Version="1.12.2" />
    <!-- Vouchfx.Community.JsonRpc 1.0.0 depends on JsonPath.Net 3.0.2, and the
         engine's Vouchfx.Steps.MqExpect.Kafka requires 3.1.0 or later. Pinning the
         engine's version here (a higher version satisfies the provider's lower bound)
         keeps restore from reporting a package downgrade (NU1605). -->
    <PackageReference Include="JsonPath.Net" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup Label="Transitive security floors — mirror the engine's Directory.Packages.props">
    <!-- This project does not inherit the engine's central transitive pinning, so
         the advisory-fixed versions the engine pins are referenced directly. Without
         them restore reports NU1902/NU1903 for the versions Aspire.Hosting and the
         engine providers pull in. Keep them at or above the engine's versions at the
         commit in ENGINE_PIN. -->
    <!-- MessagePack arrives via Aspire.Hosting -> StreamJsonRpc; 2.5.303 fixes GHSA-qhrr-8q5h-9q3h. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
    <!-- Required by Aspire.Hosting.SqlServer 13.4.6 and NuGet.Packaging in the engine;
         10.0.13 is outside GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="NuGet audit — one deliberate suppression, mirroring the engine">
    <!-- GHSA-f7vh-h5g3-7jrh (high, a macOS Aspire dashboard cookie leak via a YARP link)
         affects Aspire.Hosting and Aspire.Hosting.AppHost below 13.6.5, the only patched
         release. The engine cannot take 13.6.x during v1.x because Aspire 13.6 needs
         YamlDotNet 18.1 and the frozen v1 SDK surface keeps YamlDotNet at 16.x, so it pins
         Aspire 13.4.6 and suppresses this one advisory (Directory.Build.props in the
         engine at the commit in ENGINE_PIN holds the full reasoning). This runner
         resolves the same Aspire version and, like the engine's headless topology, never
         starts the dashboard. Only this advisory is suppressed: NuGetAuditLevel, NoWarn
         and WarningsNotAsErrors are untouched, so every other advisory still fails
         restore. Remove this item when Aspire reaches 13.6.5 or later. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-f7vh-h5g3-7jrh" />
  </ItemGroup>

</Project>
